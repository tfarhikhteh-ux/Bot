# ==========================================================
# تنظیمات نمونه سامانه School Bot (تماماً داخل پیام‌رسان بله)
# یک کپی از این فایل با نام .env بسازید و مقادیر واقعی را وارد کنید.
# ==========================================================

# توکن ربات پیام‌رسان بله (دریافتی از @botfather در بله)
BALE_BOT_TOKEN=

# شناسه یکتای عددی ادمین اصلی در بله (الزامی - بدون این مقدار سامانه متوقف می‌شود)
PRIMARY_ADMIN_ID=

# نام کامل اولیه ادمین اصلی (برای ثبت اولیه در دیتابیس)
PRIMARY_ADMIN_NAME=مدیر ارشد سامانه

# شناسه عددی گروه مدیریتی مدرسه در بله (برای ارسال درخواست‌های ثبت‌نام و گزارش‌های مدیریتی)
MANAGEMENT_GROUP_ID=

# مسیر فایل پایگاه داده SQLite و پوشه‌های پشتیبان و گزارش
DATABASE_PATH=school.db
BACKUP_DIR=backups
LOG_DIR=logs
LOG_LEVEL=INFO

# تنظیمات پایه مدرسه
SCHOOL_NAME=دبیرستان نمونه
ACADEMIC_YEAR=1405-1406
CURRENT_TERM=ترم اول
TIMEZONE=Asia/Tehran

# تنظیمات پشتیبان‌گیری خودکار
BACKUP_RETENTION_COUNT=10
AUTO_BACKUP_INTERVAL_HOURS=24

# تنظیمات امنیتی و محدودیت نرخ درخواست در بله
RATE_LIMIT_MAX_REQUESTS=25
RATE_LIMIT_WINDOW_SECONDS=60
MESSAGE_QUEUE_BATCH_SIZE=15
MESSAGE_QUEUE_RATE_DELAY_SECONDS=0.15
SCHEDULER_POLL_SECONDS=30

# تنظیمات اتصال به API رسمی بله
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_TIMEOUT_SECONDS=25
BALE_PROXY_URL=
